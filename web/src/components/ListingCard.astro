---
/**
 * One property, as a card. Used in the home page carousel, the listings grid
 * and "similar properties" on a listing page.
 */
import { Icon } from 'astro-icon/components'
import FeaturedBadge from './FeaturedBadge.astro'
import type { Listing } from '../lib/content'

interface Props {
  listing: Listing
  /** Eager-load the photo (first row above the fold). */
  priority?: boolean
}

const { listing: l, priority = false } = Astro.props
const unavailable = l.status !== 'available'
---

<a class:list={['card', { 'is-unavailable': unavailable }]} href={l.href} data-search={l.searchText} data-category={l.category?.slug ?? ''} data-deal={l.deal}>
  <div class="card__media">
    {
      l.cover ? (
        <img
          src={l.cover.src}
          srcset={l.cover.srcset}
          sizes="(max-width: 640px) 100vw, (max-width: 1100px) 50vw, 400px"
          alt={l.cover.alt}
          style={l.cover.position ? `object-position:${l.cover.position}` : undefined}
          loading={priority ? 'eager' : 'lazy'}
          decoding="async"
        />
      ) : (
        <div class="card__placeholder">
          <Icon name="lucide:image" />
          <span>Photos coming soon</span>
        </div>
      )
    }
    <div class="card__tags">
      {unavailable ? <span class="tag tag--status">{l.statusLabel}</span> : <span class="tag tag--deal">{l.dealLabel}</span>}
      {l.badge && <span class:list={['tag', l.badge.style === 'gold' ? 'tag--gold' : 'tag--navy']}>{l.badge.text}</span>}
    </div>
    {
      l.featured && !unavailable && (
        <span class="card__featured">
          <FeaturedBadge size="sm" />
        </span>
      )
    }
    {
      l.gallery.length > 1 && (
        <span class="card__count">
          <Icon name="lucide:camera" /> {l.gallery.length}
        </span>
      )
    }
    <span class="card__view">View Property <Icon name="lucide:arrow-right" /></span>
  </div>

  <div class="card__body">
    <div class="card__price">
      {l.priceLabel}
      {l.priceSuffix && <small>{l.priceSuffix}</small>}
    </div>
    <h3 class="card__title">{l.title}</h3>
    {
      l.location && (
        <p class="card__location">
          <Icon name="lucide:map-pin" /> {l.location.label}
        </p>
      )
    }
    {
      (l.facts.length > 0 || l.highlights.length > 0) && (
        <ul class="card__facts">
          {l.facts.length > 0
            ? l.facts.slice(0, 3).map((f) => (
                <li>
                  <Icon name={`lucide:${f.icon}`} />
                  <strong>{f.value}</strong> {f.label}
                </li>
              ))
            : l.highlights.slice(0, 2).map((h) => (
                <li>
                  <Icon name="lucide:check" /> {h}
                </li>
              ))}
        </ul>
      )
    }
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--surface);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(15, 43, 70, 0.05);
    transition:
      transform var(--t),
      box-shadow var(--t);
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow);
  }

  .card__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #ece9e2;
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .card:hover .card__media img {
    transform: scale(1.08);
  }
  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10, 31, 51, 0.75) 0%, rgba(10, 31, 51, 0.15) 45%, transparent 70%);
    opacity: 0.55;
    transition: opacity 0.4s;
  }
  .card:hover .card__media::after {
    opacity: 1;
  }
  .card__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    color: var(--faint);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .card__placeholder svg {
    width: 32px;
    height: 32px;
  }

  .card__tags {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    padding: 6px 11px;
    border-radius: 4px;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--white);
    background: rgba(10, 31, 51, 0.88);
    backdrop-filter: blur(4px);
  }
  .tag--deal {
    background: rgba(255, 255, 255, 0.95);
    color: var(--navy);
  }
  .tag--gold {
    background: linear-gradient(135deg, var(--gold) 0%, var(--gold-dark) 100%);
  }
  .tag--status {
    background: #b23b3b;
  }

  .card__featured {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 2;
    transition: opacity 0.3s;
  }
  /* Makes room for the "View Property" button on hover. */
  .card:hover .card__featured {
    opacity: 0;
  }
  .card__count {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px 9px;
    border-radius: 4px;
    background: rgba(10, 31, 51, 0.6);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 600;
  }
  .card__count svg {
    width: 13px;
    height: 13px;
  }
  .card__view {
    position: absolute;
    left: 50%;
    bottom: 18px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--white);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 10px);
    transition:
      opacity 0.35s,
      transform 0.35s var(--ease);
  }
  .card__view svg {
    width: 14px;
    height: 14px;
  }
  .card:hover .card__view {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .card__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 20px 22px 22px;
  }
  .card__price {
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
    color: var(--navy);
    line-height: 1.2;
  }
  .card__price small {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    margin-left: 4px;
  }
  .card__title {
    margin-top: 6px;
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.35;
  }
  .card__location {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 6px 0 18px;
    color: var(--muted);
    font-size: 0.82rem;
  }
  .card__location svg {
    width: 14px;
    height: 14px;
    color: var(--gold-dark);
    flex: none;
  }
  .card__facts {
    list-style: none;
    margin: auto 0 0;
    padding: 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .card__facts li {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .card__facts svg {
    width: 16px;
    height: 16px;
    color: var(--gold-dark);
  }
  .card__facts strong {
    color: var(--navy);
    font-weight: 700;
  }

  .card.is-unavailable .card__media img {
    filter: grayscale(0.4);
  }
</style>
