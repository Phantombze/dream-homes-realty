---
/**
 * Site footer, laid out as on the original site: the two-line wordmark and
 * gold social buttons, then the link columns and contacts in even columns
 * across the page. The link columns come from Site Settings → Footer.
 */
import { Icon } from 'astro-icon/components'
import { telHref, whatsappHref } from '../lib/content'
import { SOCIAL_ICONS, type Settings } from '../lib/site'

interface Props {
  settings: Settings
}

const { settings } = Astro.props
const wa = whatsappHref(settings.whatsapp)
// Same order as the old footer: Facebook, WhatsApp, then the rest.
const socials = [
  ...settings.socials.filter((s) => s.platform === 'facebook'),
  ...(wa ? [{ platform: 'whatsapp', url: wa }] : []),
  ...settings.socials.filter((s) => s.platform !== 'facebook'),
]
const [first, second, ...rest] = settings.companyName.split(' ')
const year = new Date().getFullYear()
---

<footer class="footer">
  <div class="container footer__grid">
    <div class="footer__brand">
      <a href="/" class="footer__logo">{first} {second}<br /><span>{rest.join(' ')}</span></a>
      <p>{settings.tagline}</p>
      <div class="footer__socials">
        {
          socials.map((s) => {
            const meta = SOCIAL_ICONS[s.platform] ?? { icon: 'lucide:link', label: s.platform }
            return (
              <a href={s.url} target="_blank" rel="noopener" aria-label={meta.label} title={meta.label}>
                <Icon name={meta.icon} />
              </a>
            )
          })
        }
      </div>
    </div>

    {
      settings.footerColumns.map((col) => (
        <nav aria-label={col.title}>
          <h3 class="footer__heading">{col.title}</h3>
          <ul class="footer__links">
            {col.links.map((l) => (
              <li>
                <a href={l.href}>{l.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))
    }

    <div>
      <h3 class="footer__heading">Contacts</h3>
      <ul class="footer__contact">
        {
          settings.phones.length > 0 && (
            <li>
              <Icon name="lucide:phone" />
              <span>
                {settings.phones.map((p) => (
                  <a href={telHref(p.display)}>{p.display}</a>
                ))}
              </span>
            </li>
          )
        }
        {
          settings.email && (
            <li>
              <Icon name="lucide:mail" />
              <a href={`mailto:${settings.email}`}>{settings.email}</a>
            </li>
          )
        }
        {
          settings.address && (
            <li>
              <Icon name="lucide:map-pin" />
              <span class="footer__address">{settings.address}</span>
            </li>
          )
        }
      </ul>
    </div>
  </div>

  <div class="footer__bar">
    <span>&copy; {year} {settings.copyright}</span>
    <div class="footer__bar-links">
      <a href="/sitemap.xml">Sitemap</a>
      <span>Designed by Ruan</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: var(--navy);
    color: var(--white);
    padding-top: clamp(64px, 8vw, 88px);
  }
  .footer::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: linear-gradient(90deg, var(--navy) 0%, var(--gold) 50%, var(--navy) 100%);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 48px;
    padding-bottom: clamp(48px, 6vw, 64px);
  }

  .footer__logo {
    display: inline-block;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1.2;
    color: var(--white);
    text-decoration: none;
  }
  .footer__logo span {
    color: var(--gold);
  }
  .footer__brand p {
    margin: 22px 0 26px;
    max-width: 320px;
    color: #b0b8c1;
    font-size: 0.92rem;
  }
  .footer__socials {
    display: flex;
    gap: 10px;
  }
  .footer__socials a {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--gold);
    color: var(--navy);
    transition: background 0.3s;
  }
  .footer__socials a:hover {
    background: var(--white);
  }
  .footer__socials svg {
    width: 16px;
    height: 16px;
  }

  .footer__heading {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 700;
    margin-bottom: 26px;
  }
  .footer__heading::after {
    content: '';
    display: block;
    width: 30px;
    height: 2px;
    margin-top: 10px;
    background: var(--gold);
  }
  .footer__links,
  .footer__contact {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 12px;
  }
  .footer__links a {
    display: inline-block;
    padding-left: 20px;
    color: #b0b8c1;
    text-decoration: none;
    font-size: 0.92rem;
    transition:
      color 0.3s,
      padding 0.3s;
  }
  .footer__links a:hover {
    color: var(--gold);
    padding-left: 25px;
  }
  .footer__contact li {
    display: flex;
    gap: 15px;
    color: #b0b8c1;
    font-size: 0.92rem;
  }
  .footer__contact svg {
    width: 18px;
    height: 18px;
    color: var(--gold);
    flex: none;
    margin-top: 2px;
  }
  .footer__contact a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .footer__contact a:hover {
    color: var(--gold);
  }
  .footer__address {
    white-space: pre-line;
  }

  /* The bottom bar runs the full width, as on the old site. */
  .footer__bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding: 24px var(--gutter);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
  }
  .footer__bar-links {
    display: flex;
    gap: 20px;
  }
  .footer__bar a {
    color: inherit;
    text-decoration: none;
  }
  .footer__bar a:hover {
    color: var(--gold);
  }

  @media (max-width: 1024px) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .footer__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
