---
/**
 * Posts to /api/contact — the shared contact service on the server (Brevo +
 * Cloudflare Turnstile), which Caddy routes before the site. It knows this
 * site by its Origin header and sends every enquiry to the inboxes listed for
 * it in sites.json.
 *
 * The service takes name / email / topic / message; the phone number and the
 * listing being asked about are folded into the message so nothing is lost.
 */
import { Icon } from 'astro-icon/components'

interface Props {
  title: string
  intro: string
  topics: string[]
  successMessage: string
  /** Pre-fills the message when arriving from a listing's "send a message" link. */
  listing?: { title: string; url: string } | null
}

const { title, intro, topics, successMessage, listing } = Astro.props
// Read per request (this site's own key, /srv/deploy/turnstile-dreamhomes.env via the service unit), so
// setting or changing the key needs a restart, not a rebuild.
const siteKey = process.env.PUBLIC_TURNSTILE_SITE_KEY || import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || ''
const preset = listing ? `I'm interested in "${listing.title}" (${listing.url}). ` : ''
---

<div class="form-card">
  <h2>{title}</h2>
  <p class="form-card__intro">{intro}</p>

  <form class="form" data-contact-form data-success={successMessage} novalidate>
    <div class="form__honey" aria-hidden="true">
      <label>Company <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
    </div>
    <div class="form__row">
      <label class="field">
        <span>Full name</span>
        <input name="name" type="text" autocomplete="name" maxlength="120" required />
      </label>
      <label class="field">
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" maxlength="200" required />
      </label>
    </div>
    <div class="form__row">
      <label class="field">
        <span>Phone <em>(optional)</em></span>
        <input name="phone" type="tel" autocomplete="tel" maxlength="40" />
      </label>
      <label class="field">
        <span>I'm interested in</span>
        <select name="topic">
          {topics.map((t) => <option selected={listing ? t === 'Buying' : undefined}>{t}</option>)}
        </select>
      </label>
    </div>
    <label class="field">
      <span>Message</span>
      <textarea name="message" rows="6" maxlength="3800" required>{preset}</textarea>
    </label>
    {listing && <input type="hidden" name="listing" value={listing.url} />}

    {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-theme="light"></div>}

    <p class="form__status" role="status" data-status hidden></p>

    <button class="btn btn-gold form__submit" type="submit">
      <Icon name="lucide:send" /> <span data-label>Send Message</span>
    </button>
  </form>
</div>

{siteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<style>
  .form-card {
    padding: clamp(24px, 4vw, 40px);
    background: var(--surface);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line);
  }
  h2 {
    font-family: var(--serif);
    font-size: 1.8rem;
    color: var(--navy);
  }
  .form-card__intro {
    color: var(--muted);
    margin: 8px 0 26px;
  }
  .form {
    display: grid;
    gap: 18px;
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  @media (max-width: 600px) {
    .form__row {
      grid-template-columns: 1fr;
    }
  }
  .field {
    display: grid;
    gap: 8px;
  }
  .field span {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--navy);
  }
  .field em {
    font-style: normal;
    font-weight: 500;
    color: var(--faint);
    text-transform: none;
    letter-spacing: 0;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--bg);
    font: inherit;
    font-size: 0.95rem;
    color: var(--text);
    transition:
      border-color 0.3s,
      background 0.3s,
      box-shadow 0.3s;
  }
  .field textarea {
    resize: vertical;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    outline: none;
    border-color: var(--gold);
    background: var(--white);
  }
  .form__honey {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form__submit {
    justify-self: start;
  }
  .form__submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
  .form__status {
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    font-size: 0.92rem;
    font-weight: 600;
  }
  .form__status.is-ok {
    background: #e7f4ea;
    color: #1d6b34;
  }
  .form__status.is-error {
    background: #fbe9e9;
    color: #a33;
  }
</style>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-contact-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!
    const button = form.querySelector<HTMLButtonElement>('button[type=submit]')!
    const label = button.querySelector<HTMLElement>('[data-label]')!

    const show = (text: string, ok: boolean) => {
      status.hidden = false
      status.textContent = text
      status.className = `form__status ${ok ? 'is-ok' : 'is-error'}`
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      if (!form.reportValidity()) return
      const data = new FormData(form)
      const phone = String(data.get('phone') || '').trim()
      const listing = String(data.get('listing') || '').trim()
      const message = [phone && `Phone: ${phone}`, listing && `Listing: ${listing}`, String(data.get('message') || '').trim()].filter(Boolean).join('\n\n')

      button.disabled = true
      label.textContent = 'Sending…'
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            topic: data.get('topic'),
            message,
            company: data.get('company'),
            token: data.get('cf-turnstile-response') ?? '',
          }),
        })
        const body = await res.json().catch(() => ({}))
        if (!res.ok) throw new Error(body.error || 'Something went wrong. Please call or WhatsApp us instead.')
        form.reset()
        show(form.dataset.success || 'Thank you — your message has been sent.', true)
      } catch (err) {
        show(err instanceof Error ? err.message : String(err), false)
      } finally {
        button.disabled = false
        label.textContent = 'Send Message'
        ;(window as any).turnstile?.reset?.()
      }
    })
  })
</script>
