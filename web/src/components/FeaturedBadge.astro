---
/**
 * "Featured" marker for listings the editor ticked Featured: a gold pill whose
 * star twinkles and a soft sheen passes over every few seconds. Still for
 * visitors who prefer reduced motion.
 */
interface Props {
  size?: 'sm' | 'md'
}

const { size = 'md' } = Astro.props
---

<span class:list={['featured', `featured--${size}`]}>
  <svg class="featured__star" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 2.5l2.9 6.1 6.6.8-4.9 4.6 1.3 6.6L12 17.3l-5.9 3.3 1.3-6.6L2.5 9.4l6.6-.8z" />
  </svg>
  Featured
</span>

<style>
  .featured {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    overflow: hidden;
    border-radius: 999px;
    background: linear-gradient(135deg, #d8b46a 0%, var(--gold) 45%, #a8823c 100%);
    color: var(--white);
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    white-space: nowrap;
    border: 1px solid rgba(255, 255, 255, 0.35);
  }
  .featured--md {
    padding: 7px 14px 7px 11px;
    font-size: 0.68rem;
  }
  .featured--sm {
    padding: 5px 11px 5px 8px;
    font-size: 0.62rem;
    gap: 5px;
  }

  .featured__star {
    width: 14px;
    height: 14px;
    fill: var(--white);
    animation: twinkle 3.2s ease-in-out infinite;
  }
  .featured--sm .featured__star {
    width: 12px;
    height: 12px;
  }

  /* The sheen: a soft diagonal highlight that passes once, then rests. */
  .featured::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgba(255, 255, 255, 0.55) 50%, transparent 65%);
    transform: translateX(-120%);
    animation: sheen 4.5s ease-in-out infinite;
  }

  @keyframes twinkle {
    0%,
    70%,
    100% {
      transform: scale(1) rotate(0deg);
    }
    80% {
      transform: scale(1.25) rotate(18deg);
    }
    90% {
      transform: scale(0.95) rotate(-6deg);
    }
  }
  @keyframes sheen {
    0%,
    55% {
      transform: translateX(-120%);
    }
    80%,
    100% {
      transform: translateX(120%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .featured__star,
    .featured::after {
      animation: none;
    }
    .featured::after {
      display: none;
    }
  }
</style>
