---
import { Icon } from 'astro-icon/components'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import ContactForm from '../components/ContactForm.astro'
import { getSingle } from '../lib/cms'
import { telHref, whatsappHref } from '../lib/content'
import { getListings, getSettings } from '../lib/site'

const [page, settings, listings] = await Promise.all([getSingle('realty-contact'), getSettings(), getListings()])

const wanted = Astro.url.searchParams.get('listing')
const match = wanted ? listings.find((l) => l.slug === wanted) : null
const site = (Astro.site?.href ?? '').replace(/\/$/, '')
const listing = match ? { title: match.title, url: `${site}${match.href}` } : null
const wa = whatsappHref(settings.whatsapp)
---

<BaseLayout active="contact" overHero title={page.seo?.title || 'Contact'} description={page.seo?.description}>
  <PageHero eyebrow={page.hero?.eyebrow} title={page.hero?.title} text={page.hero?.text} crumbs={[{ label: 'Contact' }]} />

  <div class="container section">
    <div class="layout">
      <div data-reveal>
        <ContactForm title={page.formTitle} intro={page.formIntro} topics={page.topics ?? []} successMessage={page.successMessage} listing={listing} />
      </div>

      <div class="side">
        <div class="quick" data-reveal>
          {
            settings.phones.map((p, i) => (
              <a class="quick__item" href={telHref(p.display)}>
                <span class="quick__icon">
                  <Icon name="lucide:phone" />
                </span>
                <span>
                  <small>{p.label || (i === 0 ? 'Call' : 'Phone')}</small>
                  <strong>{p.display}</strong>
                </span>
              </a>
            ))
          }
          {
            wa && (
              <a class="quick__item" href={wa} target="_blank" rel="noopener">
                <span class="quick__icon quick__icon--wa">
                  <Icon name="fa6-brands:whatsapp" />
                </span>
                <span>
                  <small>WhatsApp</small>
                  <strong>Message us</strong>
                </span>
              </a>
            )
          }
          {
            settings.email && (
              <a class="quick__item" href={`mailto:${settings.email}`}>
                <span class="quick__icon">
                  <Icon name="lucide:mail" />
                </span>
                <span>
                  <small>Email</small>
                  <strong>{settings.email}</strong>
                </span>
              </a>
            )
          }
        </div>

        <div class="panel" data-reveal>
          <h3><Icon name="lucide:map-pin" /> Office</h3>
          <p class="address">{settings.address}</p>
          {
            settings.mapLink && (
              <a class="panel__link" href={settings.mapLink} target="_blank" rel="noopener">
                Get directions <Icon name="lucide:arrow-up-right" />
              </a>
            )
          }
        </div>

        {
          settings.officeHours.length > 0 && (
            <div class="panel" data-reveal>
              <h3>
                <Icon name="lucide:clock" /> Office Hours
              </h3>
              <dl class="hours">
                {settings.officeHours.map((h) => (
                  <>
                    <dt>{h.days}</dt>
                    <dd>{h.hours}</dd>
                  </>
                ))}
              </dl>
            </div>
          )
        }
      </div>
    </div>

    {
      settings.mapEmbedUrl && (
        <div class="map" data-reveal>
          <iframe src={settings.mapEmbedUrl} title={`Map to ${settings.companyName}`} loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen />
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 40px;
    align-items: start;
  }
  @media (max-width: 960px) {
    .layout {
      grid-template-columns: 1fr;
    }
  }
  .side {
    display: grid;
    gap: 20px;
  }
  .quick {
    display: grid;
    gap: 12px;
  }
  .quick__item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      transform 0.3s var(--ease),
      box-shadow 0.3s,
      border-color 0.3s;
  }
  .quick__item:hover {
    border-color: var(--gold);
  }
  .quick__icon {
    width: 46px;
    height: 46px;
    flex: none;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--navy);
    color: var(--gold);
  }
  .quick__icon--wa {
    background: #25d366;
    color: var(--white);
  }
  .quick__icon svg {
    width: 20px;
    height: 20px;
  }
  .quick__item small {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--faint);
  }
  .quick__item strong {
    color: var(--navy);
    font-size: 1rem;
    word-break: break-word;
  }
  .panel {
    padding: 24px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .panel h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--navy);
    margin-bottom: 12px;
  }
  .panel h3 svg {
    width: 20px;
    height: 20px;
    color: var(--gold-dark);
  }
  .address {
    white-space: pre-line;
    color: var(--muted);
  }
  .panel__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    color: var(--gold-dark);
    font-weight: 700;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .panel__link svg {
    width: 15px;
    height: 15px;
  }
  .hours {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 8px 20px;
    margin: 0;
    font-size: 0.92rem;
  }
  .hours dt {
    font-weight: 600;
    color: var(--navy);
  }
  .hours dd {
    margin: 0;
    color: var(--muted);
    text-align: right;
  }
  .map {
    margin-top: 48px;
    height: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #e8e4dc;
  }
  .map iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
