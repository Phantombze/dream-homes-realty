---
import { Icon } from 'astro-icon/components'
import BaseLayout from '../layouts/BaseLayout.astro'
import PageHero from '../components/PageHero.astro'
import SectionHeader from '../components/SectionHeader.astro'
import CtaBand from '../components/CtaBand.astro'
import { getSingle } from '../lib/cms'
import { toImage } from '../lib/content'
import { getSettings } from '../lib/site'

const [page, settings] = await Promise.all([getSingle('realty-about'), getSettings()])
const rows = (page.community?.rows ?? []).map((r: any) => ({ ...r, image: toImage(r.image, r.title), paragraphs: String(r.text ?? '').split(/\n\s*\n/).filter(Boolean) }))
---

<BaseLayout active="about" overHero title={page.seo?.title || 'About Us'} description={page.seo?.description}>
  <PageHero eyebrow={page.hero?.eyebrow} title={page.hero?.title} text={page.hero?.text} image={rows[0]?.image} crumbs={[{ label: 'About Us' }]} />

  {
    page.pillars?.length > 0 && (
      <section class="container section">
        <div class="pillars">
          {page.pillars.map((p: any, i: number) => (
            <article class="pillar" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
              <span class="pillar__icon">
                <Icon name={`lucide:${p.icon || 'star'}`} />
              </span>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </article>
          ))}
        </div>
      </section>
    )
  }

  {
    rows.length > 0 && (
      <section class="community">
        <div class="container section">
          <div class="community__head" data-reveal>
            <span class="eyebrow">{page.community.eyebrow}</span>
            <h2>{page.community.title}</h2>
            <span class="community__rule" />
          </div>
          {rows.map((r: any, i: number) => (
            <div class:list={['row', { 'row--reverse': i % 2 === 1 }]} data-reveal>
              <div class="row__media">{r.image && <img src={r.image.src} srcset={r.image.srcset} sizes="(max-width: 900px) 100vw, 50vw" alt={r.image.alt} loading="lazy" decoding="async" />}</div>
              <div class="row__text">
                <span class="eyebrow">{r.eyebrow}</span>
                <h3>{r.title}</h3>
                {r.paragraphs.map((p: string) => (
                  <p>{p}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>
    )
  }

  <div class="container section">
    {
      page.services?.items?.length > 0 && (
        <>
          <SectionHeader eyebrow={page.services.eyebrow} title={page.services.title} />
          <div class="services">
            {page.services.items.map((s: any, i: number) => (
              <div class="service" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
                <span class="service__icon">
                  <Icon name={`lucide:${s.icon || 'check'}`} />
                </span>
                <h4>{s.label}</h4>
              </div>
            ))}
          </div>
          <div class="spacer" />
        </>
      )
    }

    {page.cta && <CtaBand {...page.cta} settings={settings} />}
  </div>
</BaseLayout>

<style>
  .pillars {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  @media (max-width: 900px) {
    .pillars {
      grid-template-columns: 1fr;
    }
  }
  .pillar {
    padding: 40px 32px;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid rgba(15, 43, 70, 0.05);
    text-align: center;
    transition:
      transform var(--t),
      box-shadow var(--t);
  }
  .pillar:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow);
  }
  .pillar__icon {
    width: 68px;
    height: 68px;
    margin: 0 auto 22px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--navy);
    color: var(--gold);
  }
  .pillar__icon svg {
    width: 28px;
    height: 28px;
  }
  .pillar h3 {
    font-family: var(--serif);
    font-size: 1.5rem;
    color: var(--navy);
    margin-bottom: 12px;
  }
  .pillar p {
    color: var(--muted);
  }

  .community {
    background: var(--navy);
    color: var(--white);
  }
  .community__head {
    text-align: center;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .community__head .eyebrow {
    color: var(--gold);
  }
  .community__head h2 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin-top: 12px;
  }
  .community__rule {
    display: block;
    width: 60px;
    height: 2px;
    margin: 20px auto 0;
    background: var(--gold);
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .row + .row {
    margin-top: clamp(48px, 7vw, 90px);
  }
  .row--reverse .row__media {
    order: 2;
  }
  .row__media {
    position: relative;
  }
  .row__media::before {
    content: '';
    position: absolute;
    inset: 20px -20px -20px 20px;
    border: 2px solid var(--gold);
    border-radius: var(--radius);
  }
  .row--reverse .row__media::before {
    inset: 20px 20px -20px -20px;
  }
  .row__media img {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }
  .row__text .eyebrow {
    color: var(--gold);
  }
  .row__text h3 {
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 12px 0 18px;
  }
  .row__text p {
    color: rgba(255, 255, 255, 0.8);
  }
  .row__text p + p {
    margin-top: 14px;
  }
  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr;
    }
    .row--reverse .row__media {
      order: 0;
    }
    .row__media::before,
    .row--reverse .row__media::before {
      inset: 12px -12px -12px 12px;
    }
  }

  .services {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  @media (max-width: 900px) {
    .services {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .service {
    padding: 32px 20px;
    text-align: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    transition:
      border-color 0.3s,
      transform 0.3s var(--ease);
  }
  .service:hover {
    border-color: var(--gold);
    transform: translateY(-4px);
  }
  .service__icon {
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--gold-soft);
    color: var(--gold-dark);
  }
  .service__icon svg {
    width: 24px;
    height: 24px;
  }
  .service h4 {
    font-size: 1rem;
    color: var(--navy);
  }
  .spacer {
    height: clamp(56px, 8vw, 100px);
  }
</style>
