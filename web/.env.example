# Where Payload's API is. On the server this is the loopback; locally, the dev CMS.
PAYLOAD_API_URL=http://localhost:3000
# Which tenant's content this site shows (Tenants collection, slug field).
PAYLOAD_TENANT=dreamhomes
# Shared with the CMS: lets a save in Payload clear this site's cache.
REVALIDATE_SECRET=change-me
PUBLIC_SITE_URL=https://www.dreamhomes-realty.com
# Cloudflare Turnstile site key (public). Leave empty to hide the widget.
PUBLIC_TURNSTILE_SITE_KEY=
