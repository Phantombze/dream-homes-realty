# ---------------------------------------------------------------------------
# dreamhomes-realty.com — Astro rendered per request, content live from Payload
# ---------------------------------------------------------------------------
www.dreamhomes-realty.com {
	import security_headers
	encode zstd gzip

	# Contact form → the shared contact service (Brevo + Turnstile).
	handle /api/contact {
		reverse_proxy 127.0.0.1:8787
	}

	# Build assets carry a content hash in their name: served straight from
	# disk and cached forever, Node never sees them.
	handle /_astro/* {
		root * /srv/src/dreamhomes/web/dist/client
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Pages, /media/* (Payload uploads, cached immutably by the app) and
	# everything else.
	handle {
		reverse_proxy 127.0.0.1:4330 {
			header_up X-Forwarded-Proto https
		}
	}

	log {
		output file /var/log/caddy/dreamhomes.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}

dreamhomes-realty.com {
	redir https://www.dreamhomes-realty.com{uri} permanent
}
