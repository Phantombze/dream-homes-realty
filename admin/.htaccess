<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|db\.php|auth\.php|bootstrap\.php|schema\.sql)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_authz_host.c>
    <FilesMatch "^(config\.php|db\.php|auth\.php|bootstrap\.php|schema\.sql)$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

RedirectMatch 403 ^/admin/includes/
